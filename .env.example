# --- Market data (required) ---
# Free key: https://twelvedata.com — data vendor, not a regulated broker,
# so it works regardless of your country.
TWELVEDATA_API_KEY=

# --- Fundamental filter (optional, degrades gracefully if unset) ---
# Free key: https://finnhub.io — used for the economic calendar veto
# (avoids signaling right before high-impact news). Verify current
# free-tier calendar access when you sign up; if unavailable the bot
# just skips the fundamental check and says so.
FINNHUB_API_KEY=

# --- Push notifications (optional) ---
# Install the ntfy app (Android/iOS/web: https://ntfy.sh) and subscribe to
# this exact topic name to get alerts. No account/signup needed. Anyone who
# knows this topic string can subscribe too, so keep it private (it's
# randomly generated below — don't rename it to something guessable).
NTFY_TOPIC=

# --- Telegram bot (optional) ---
# Create a bot via @BotFather in Telegram to get TELEGRAM_BOT_TOKEN, then
# message the bot once and fetch https://api.telegram.org/bot<token>/getUpdates
# to find TELEGRAM_CHAT_ID (your chat's "id" field).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Legacy/optional: only needed for automatic order execution via a
# broker. Not required for advisory (chat) analysis or backtesting. ---
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Instrument and timeframe (Twelve Data format: "EUR/USD", interval "1h")
PAIR=EUR/USD
GRANULARITY=1h

# Strategy parameters
FAST_EMA=20
SLOW_EMA=50
ATR_PERIOD=14
RSI_PERIOD=14
ATR_STOP_MULT=1.5
ATR_TARGET_MULT=3.0
ADX_THRESHOLD=20.0

# Risk management
RISK_PER_TRADE=0.01
MAX_OPEN_TRADES=1

# Loop interval in seconds — only used by bot/main.py (legacy auto-execution loop)
POLL_INTERVAL_SECONDS=60
